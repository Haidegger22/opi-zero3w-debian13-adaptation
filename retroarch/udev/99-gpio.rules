# udev: GPIO + I2C доступ для группы input (нужно для game_input.py / mario_buttons.py / m5hub)
# Debian 13: без доступа к /dev/i2c-* игровой мост падает (PermissionError)
SUBSYSTEM=="gpio", KERNEL=="gpiochip*", GROUP="input", MODE="0660"
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-*", GROUP="input", MODE="0660"
